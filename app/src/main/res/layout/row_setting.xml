<?xml version="1.0" encoding="utf-8"?>
<!-- One setting row: phase dot, label, and the value as a tappable pill.
     Tapping the row opens the roller picker dialog (no - / + steppers). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="12dp"
    android:paddingStart="20dp">

    <View
        android:id="@+id/rowDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="12dp" />

    <TextView
        android:id="@+id/rowLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/inter_medium"
        android:textColor="@color/on_surface"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/rowValuePill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:background="@drawable/bg_value_pill"
        android:gravity="center"
        android:minWidth="76dp"
        android:orientation="horizontal"
        android:paddingEnd="10dp"
        android:paddingStart="16dp">

        <TextView
            android:id="@+id/rowValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk_semibold"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/on_surface"
            android:textSize="22sp" />

        <ImageView
            android:id="@+id/rowChevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/on_surface_variant" />
    </LinearLayout>
</LinearLayout>

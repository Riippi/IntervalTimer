<?xml version="1.0" encoding="utf-8"?>
<!-- One action in the workout menu sheet: icon and label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheetRow"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/bg_sheet_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="24dp"
    android:paddingStart="24dp">

    <ImageView
        android:id="@+id/sheetIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        app:tint="@color/on_surface" />

    <TextView
        android:id="@+id/sheetLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/inter_regular"
        android:maxLines="1"
        android:textColor="@color/on_surface"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/sheetChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone"
        app:tint="@color/on_surface_muted" />
</LinearLayout>

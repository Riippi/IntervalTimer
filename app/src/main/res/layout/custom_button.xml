<?xml version="1.0" encoding="utf-8"?>
<org.leeko.intervaltimer.CustomButton
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/themex_btn_default_holo_dark"
    android:gravity="center_horizontal"
    android:id="@+id/test_button"
    android:clickable="true"
    android:weightSum="100"
    style="@style/ButtonThemeX"
    >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="Text on left"
        android:id="@+id/textViewXLeft"
        android:layout_gravity="left|center_vertical"
        android:layout_weight="40"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="Text on right"
        android:id="@+id/textViewXRight"
        android:layout_gravity="right|center_vertical"
        android:gravity="right"
        android:layout_weight="40"
        android:textAlignment="gravity" />

</org.leeko.intervaltimer.CustomButton>
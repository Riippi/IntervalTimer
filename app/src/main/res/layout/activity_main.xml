<?xml version="1.0" encoding="utf-8"?>
<!-- Main screen (workout setup): app bar, workout chips, swipeable workout pages, Start. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="8dp"
        android:paddingStart="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/space_grotesk_semibold"
            android:letterSpacing="-0.01"
            android:id="@+id/mainTitle"
            android:text="@string/main_title"
            android:textColor="@color/on_surface"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/addWorkoutButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/new_workout"
            android:src="@drawable/ic_add"
            app:tint="@color/on_surface" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_settings"
            android:src="@drawable/ic_tune"
            app:tint="@color/on_surface" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/chipsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="12dp"
        android:paddingEnd="12dp"
        android:paddingStart="20dp"
        android:paddingTop="2dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chipsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <org.leeko.intervaltimer.view.MaxWidthLinearLayout
        android:id="@+id/startButton"
        android:layout_width="match_parent"
        android:layout_gravity="center_horizontal"
        app:maxContentWidth="@dimen/content_max_width"
        android:layout_height="64dp"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_start_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_play"
            app:tint="@color/on_phase"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/space_grotesk_bold"
            android:letterSpacing="0.02"
            android:text="@string/start_button"
            android:textColor="@color/on_phase"
            android:textSize="20sp" />
    </org.leeko.intervaltimer.view.MaxWidthLinearLayout>
</LinearLayout>

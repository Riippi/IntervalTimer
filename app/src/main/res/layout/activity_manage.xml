<?xml version="1.0" encoding="utf-8"?>
<!-- Manage workouts: reorder by dragging, swipe a row left to delete (with Undo). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/manageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ManageActivity">

    <LinearLayout
        android:id="@+id/manageHeader"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/manageBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/on_surface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:fontFamily="@font/space_grotesk_semibold"
            android:id="@+id/manageTitle"
            android:text="@string/manage_title"
            android:textColor="@color/on_surface"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/manageAdd"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/new_workout"
            android:src="@drawable/ic_add"
            app:tint="@color/on_surface" />
    </LinearLayout>

    <TextView
        android:id="@+id/manageCaption"
        android:layout_width="0dp"
        app:layout_constraintWidth_max="@dimen/content_max_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_regular"
        android:lineSpacingMultiplier="1.15"
        android:text="@string/manage_caption"
        android:textColor="@color/on_surface_variant"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/manageHeader" />

    <!-- Hugs its rows, but never grows into the New workout button -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/manageList"
        android:layout_width="0dp"
        app:layout_constraintWidth_max="@dimen/content_max_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_card"
        android:clipToOutline="true"
        android:outlineProvider="background"
        android:overScrollMode="never"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@id/manageNew"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/manageCaption"
        app:layout_constraintVertical_bias="0" />

    <LinearLayout
        android:id="@+id/manageNew"
        android:layout_width="0dp"
        app:layout_constraintWidth_max="@dimen/content_max_width"
        android:layout_height="56dp"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_outline_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_add"
            app:tint="@color/on_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/manage_new_workout"
            android:textColor="@color/on_surface"
            android:textSize="16sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

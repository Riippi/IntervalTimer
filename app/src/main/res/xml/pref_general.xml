<?xml version="1.0" encoding="utf-8"?>
<!-- The settings. The keys (and so everyone's saved values) are the same as before the redesign;
     AppController and TimerActivity read them from the default shared preferences. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        android:widgetLayout="@layout/pref_switch_widget"
        android:defaultValue="true"
        android:key="prevent_screensaver_checkbox"
        android:summary="@string/pref_summary_keep_screen_on"
        android:title="@string/pref_title_keep_screen_on"
        app:singleLineTitle="false" />

    <SwitchPreferenceCompat
        android:widgetLayout="@layout/pref_switch_widget"
        android:defaultValue="true"
        android:key="pause_on_incoming_call"
        android:summary="@string/pref_summary_pause_on_call"
        android:title="@string/pref_title_pause_on_call"
        app:singleLineTitle="false" />

    <!-- The parent of the sound tone below: that one is only enabled while this is on. -->
    <SwitchPreferenceCompat
        android:widgetLayout="@layout/pref_switch_widget"
        android:defaultValue="true"
        android:key="sound"
        android:title="@string/pref_title_sound_alert"
        app:singleLineTitle="false" />

    <ListPreference
        android:defaultValue="0"
        android:dependency="sound"
        android:entries="@array/pref_sound_list_titles"
        android:entryValues="@array/pref_sound_list_values"
        android:key="sound_list"
        android:title="@string/pref_title_sound_tone"
        app:singleLineTitle="false"
        app:useSimpleSummaryProvider="true" />

    <SwitchPreferenceCompat
        android:widgetLayout="@layout/pref_switch_widget"
        android:defaultValue="true"
        android:key="vibrate"
        android:title="@string/pref_title_vibrate"
        app:singleLineTitle="false" />

    <ListPreference
        android:defaultValue="0"
        android:entries="@array/pref_countdown_list_titles"
        android:entryValues="@array/pref_countdown_list_values"
        android:key="countdown"
        android:title="@string/pref_title_countdown"
        app:singleLineTitle="false"
        app:useSimpleSummaryProvider="true" />

    <!-- Hidden on large screens by SettingsActivity (Android ignores the lock there). -->
    <SwitchPreferenceCompat
        android:widgetLayout="@layout/pref_switch_widget"
        android:defaultValue="false"
        android:key="lock_portrait"
        android:summary="@string/pref_summary_lock_portrait"
        android:title="@string/pref_title_lock_portrait"
        app:singleLineTitle="false" />

    <Preference
        android:key="privacy_policy"
        android:summary="@string/pref_summary_privacy"
        android:title="@string/pref_title_privacy"
        app:singleLineTitle="false">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://moriest.fi/IntervalTimer/" />
    </Preference>

    <Preference
        android:key="app_version"
        android:selectable="false"
        android:title="@string/pref_title_version"
        app:singleLineTitle="false" />
</PreferenceScreen>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Redesign tokens (see design/redesign/DESIGN_HANDOFF.md). -->

    <!-- Running timer: the whole screen takes the color of the current phase.
         Traffic-light colors mean the same thing everywhere in the app. -->
    <color name="phase_warmup">#FFD60A</color>
    <color name="phase_work">#2BE04F</color>
    <color name="phase_rest">#FF3B30</color>
    <color name="phase_done">#EDEEEF</color>

    <!-- Text, icons and buttons that sit on a phase color. -->
    <color name="on_phase">#0A0A0A</color>
    <color name="on_phase_secondary">#B80A0A0A</color>        <!-- 72% -->
    <color name="on_phase_button">#1F0A0A0A</color>           <!-- 12%: round icon buttons -->
    <color name="on_phase_track">#2E0A0A0A</color>            <!-- 18%: unfinished progress segments -->
    <color name="on_phase_ripple">#33000000</color>
    <color name="on_dark_pill">#F5F5F5</color>                <!-- text/icons on the black pill button -->

    <!-- Surfaces and text on the dark app screens (main screen, dialogs, sheets). -->
    <color name="background">#0E0F11</color>
    <color name="surface">#17191C</color>                     <!-- cards, list rows -->
    <color name="surface_high">#1E2125</color>                <!-- dialogs, bottom sheet -->
    <color name="surface_button">#23262A</color>              <!-- round and value buttons -->
    <color name="outline">#34383E</color>                     <!-- unselected chip border -->
    <color name="divider">#24272B</color>
    <color name="on_surface">#ECEDEE</color>
    <color name="on_surface_variant">#A1A7AE</color>
    <color name="on_surface_muted">#8E949C</color>
    <color name="chip_text">#C9CDD2</color>
    <color name="chip_selected_text">#111315</color>
    <color name="switch_outline">#5A6068</color>
    <color name="destructive">#FF8080</color>
    <color name="sheet_divider">#2C3035</color>
    <color name="button_outline">#4A4F56</color>
    <color name="drag_surface">#2A2E33</color>
    <color name="swipe_delete_background">#3A1F1F</color>
    <color name="sheet_handle">#4A4F56</color>
    <color name="snackbar_action">#A33F00</color>
    <color name="snackbar_background">#ECEDEE</color>
    <color name="snackbar_text">#111315</color>

    <!-- Window background shown before the first frame is drawn. -->
    <color name="timer_window_background">#0E0F11</color>
</resources>

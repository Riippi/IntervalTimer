<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The running timer paints its own full-screen colors, so the window background is the
         dark app color until the first frame (the activity then colors it from code) and the
         system bars are transparent. Same Material 3 base as the other screens, so its dialog
         matches them. -->
    <style name="ThemeTimer" parent="Theme.IntervalTimer">
        <item name="android:windowBackground">@color/timer_window_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>

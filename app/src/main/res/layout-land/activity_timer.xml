<?xml version="1.0" encoding="utf-8"?>
<!-- Running timer, landscape: digits on the left at the biggest size that fits, a side
     panel with what is next / remaining / the pause button, progress bar along the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="20dp"
    android:paddingEnd="24dp"
    android:paddingStart="32dp"
    android:paddingTop="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/phaseLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:textColor="@color/on_phase"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/roundText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/on_phase"
            android:textSize="22sp" />

        <ImageButton
            android:id="@+id/endButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_end_workout"
            android:scaleType="center"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 800sp is only the upper limit; FitTextView picks the largest size that fits. -->
        <org.leeko.intervaltimer.view.FitTextView
            android:id="@+id/digits"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:letterSpacing="-0.05"
            android:textColor="@color/on_phase"
            android:textSize="800sp" />

        <LinearLayout
            android:layout_width="236dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nextText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="23dp"
                android:textColor="@color/on_phase_secondary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/remainingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.08"
                android:text="@string/label_remaining"
                android:textColor="@color/on_phase_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/remainingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/on_phase"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/pausedPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_paused_pill"
                android:letterSpacing="0.1"
                android:paddingBottom="6dp"
                android:paddingEnd="14dp"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:text="@string/state_paused"
                android:textColor="@color/on_dark_pill"
                android:textSize="14sp"
                android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/pauseButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill_dark"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/pauseIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pause" />

                <TextView
                    android:id="@+id/pauseLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:letterSpacing="0.06"
                    android:textColor="@color/on_dark_pill"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <org.leeko.intervaltimer.view.SegmentedProgressView
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="8dp" />

</LinearLayout>

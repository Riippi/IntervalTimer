<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="3dp"
    android:paddingLeft="3dp"
    android:paddingRight="3dp"
    android:paddingTop="3dp"
    tools:context=".TimerActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="10">


        <RelativeLayout
            android:id="@+id/layoutTop"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6">

            <View
                android:id="@+id/timerTrafficLight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/rounded_corner" />


            <TextView
                android:id="@+id/roundText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="22dp"
                android:text="NEXT: ROUND 90 of 90"
                android:textColor="@color/black"
                android:textSize="@dimen/scale_roundof_font_ls"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_below="@+id/roundText"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="20dp"
                android:text="PAUSED"
                android:textColor="@color/black"
                android:textSize="@dimen/scale_state_font_ls"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_gravity="center"
                android:layout_marginRight="20dp"
                android:gravity="right"
                android:text="00:00"
                android:textColor="@color/black"
                android:textSize="@dimen/scale_font_ls"
                android:textStyle="bold"
                android:layout_centerVertical="true" />

        </RelativeLayout>


        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="10dp"
            android:layout_weight="4"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="6"
            android:baselineAligned="false">


            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/layoutTop"
                android:layout_weight="4"
                android:paddingBottom="@dimen/activity_vertical_margin"
                android:paddingLeft="@dimen/activity_horizontal_margin"
                android:paddingRight="@dimen/activity_horizontal_margin"
                android:paddingTop="@dimen/activity_vertical_margin"
                tools:context=".TimerActivity"
                >

                <!-- TOTAL ELAPSED -->
                <TextView
                    android:id="@+id/textTotalElapsedTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_marginTop="5dp"
                    android:text="ELAPSED"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <TextView
                    android:id="@+id/textTotalElapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_below="@+id/textTotalElapsedTitle"
                    android:layout_marginTop="5dp"
                    android:text="0:00"
                    android:textAppearance="?android:attr/textAppearanceMedium" />


                <!-- TOTAL REMAINING -->
                <TextView
                    android:id="@+id/textTotalRemainingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@+id/textTotalElapsedTitle"
                    android:layout_alignParentRight="true"
                    android:text="REMAINING"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#ffdcdcdc" />

                <TextView
                    android:id="@+id/textTotalRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@+id/textTotalElapsed"
                    android:layout_alignParentRight="true"
                    android:text="0:00"
                    android:textAppearance="?android:attr/textAppearanceMedium" />


                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentRight="true"
                    android:layout_below="@+id/textTotalElapsed"
                    android:layout_marginTop="10dp" />


            </RelativeLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_marginBottom="10dp"
                android:layout_weight="2"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/pauseButton"
                    android:layout_width="fill_parent"
                    android:layout_height="50dp"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:text="PAUSE"
                    android:layout_margin="10dp"
                    android:textSize="26sp"
                    />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
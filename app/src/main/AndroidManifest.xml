<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" >

    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Declaring this as required tells Google Play to hide the app from devices
         without a touchscreen (e.g. some Android TV boxes) - the UI only works by
         tapping buttons, there's no d-pad/remote navigation support. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.IntervalTimer" >

        <activity
            android:name="org.leeko.intervaltimer.MainActivity"
            android:label="@string/app_name"
            android:theme="@style/Theme.IntervalTimer"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="org.leeko.intervaltimer.TimerActivity"
            android:label="@string/app_name"
            android:parentActivityName="org.leeko.intervaltimer.MainActivity"
            android:theme="@style/ThemeTimer"
            android:exported="false"
            android:enableOnBackInvokedCallback="true"
            android:configChanges="keyboardHidden|orientation|screenSize">
        </activity>

        <activity
            android:name="org.leeko.intervaltimer.ManageActivity"
            android:label="@string/manage_title"
            android:parentActivityName="org.leeko.intervaltimer.MainActivity"
            android:theme="@style/Theme.IntervalTimer"
            android:exported="false" />

        <provider
            android:name=".contentprovider.MyContentProvider"
            android:authorities="org.leeko.intervaltimer.contentprovider"
            android:exported="false" >
        </provider>

        <activity
            android:name="org.leeko.intervaltimer.SettingsActivity"
            android:label="@string/title_activity_settings"
            android:parentActivityName="org.leeko.intervaltimer.MainActivity"
            android:theme="@style/Theme.IntervalTimer"
            android:exported="false">
        </activity>
    </application>

</manifest>
